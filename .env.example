# --- Kimi K3 teacher: OpenRouter (one key serves every model in this project) ---
TEACHER_API_KEY=
TEACHER_BASE_URL=https://openrouter.ai/api/v1
TEACHER_MODEL=moonshotai/kimi-k3
# Completion-token cap per call (default 4096). OpenRouter RESERVES credit for the full
# value up front, so leaving the model's 65_536 ceiling reserves ~$0.98/call. Raise if K3's
# thinking ever truncates the JSON; lower once the smoke test shows real token usage.
# TEACHER_MAX_TOKENS=4096

# --- OR Together AI ---
# TEACHER_BASE_URL=https://api.together.xyz/v1
# TEACHER_MODEL=moonshotai/Kimi-K3

# --- OR Moonshot first-party (waitlisted for new accounts right now) ---
# TEACHER_BASE_URL=https://api.moonshot.ai/v1
# TEACHER_MODEL=kimi-k3

# --- Frontier panel ---
# With OpenRouter, the SAME TEACHER_API_KEY can run the whole panel (GPT-5.6, Gemini,
# open peers) — no separate provider keys needed. The one exception: the Anthropic
# entry runs via your Claude Code subscription (headless `claude -p`), free.

# Hugging Face: public datasets need no token; set only to push the model card/weights.
# HF_TOKEN=
