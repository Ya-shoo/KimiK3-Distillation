# Python
__pycache__/
*.pyc
.venv/
.uv/
dist/
build/
*.egg-info/

# Env / secrets
.env
.env.*
!.env.example

# Data — raw + splits are regenerated by seeded scripts (hashes committed under artifacts/).
data/*
# ...but DO track the K3-labeled set: it cost real $ and isn't cheaply regenerable.
!data/label/
data/label/*
!data/label/labeled.jsonl
!data/label/subsample.parquet
!data/label/targets/
data/label/targets/*
!data/label/targets/*.jsonl
!data/label/targets/*.json
# Same policy for the CLINC benchmark's labeled set.
!data/clinc/
data/clinc/*
!data/clinc/label/
data/clinc/label/*
!data/clinc/label/labeled.jsonl
!data/clinc/label/subsample.parquet
!data/clinc/label/targets/
data/clinc/label/targets/*
!data/clinc/label/targets/*.jsonl
!data/clinc/label/targets/*.json

# Model weights / large outputs
outputs/
checkpoints/
*.safetensors
*.gguf
*.bin

# OS / editor
.DS_Store
.idea/
.vscode/
runs/
unsloth_compiled_cache/
